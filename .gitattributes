# Normalise line endings so cross-platform launchers keep working.
* text=auto eol=lf

# Unix shell scripts MUST stay LF (a CRLF shebang breaks them on macOS/Linux).
*.sh    text eol=lf
*.command text eol=lf

# Windows-only launchers stay CRLF.
*.vbs   text eol=crlf
*.ps1   text eol=crlf

# Binary assets — never touch.
*.png   binary
*.ico   binary
